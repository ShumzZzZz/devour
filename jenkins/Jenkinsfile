pipeline {
  agent any

  options {
    buildDiscarder(logRotator(artifactDaysToKeepStr: '', artifactNumToKeepStr: '5', daysToKeepStr: '', numToKeepStr: '5'))
    disableConcurrentBuilds()
  }

  stages {
    // stage('Notify') {
    //   when { anyOf { branch 'main'; changeRequest() } }
    //   steps {
    //     echo 'Push Received!'
    //   }
    // }

    stage('Lint / Ruff') {
      when {
        anyOf {
          branch 'main'
          changeRequest()
        }
      }
      agent { label 'uv' }

      environment {
        LINT_PATH = '.'
        GITHUB_CONTEXT = 'lint/ruff' // used for GitHub Checks
      }

      steps {
        checkout scm

        publishChecks name: env.GITHUB_CONTEXT,
                     title: 'Ruff',
                     summary: 'Ruff lint started…',
                     status: 'IN_PROGRESS'

  container(name: 'uv', shell: '/bin/bash') {
    script {
      int rc = sh(returnStatus: true, script: """
        set -euo pipefail
        # (optional) quick visibility
        echo "INSIDE CONTAINER: $(cat /etc/os-release | sed -n '1p')"
        echo "PATH=$PATH"
        command -v uv || true

        uv tool run ruff check "${LINT_PATH}" | tee ruff-report.txt
        uv tool run ruff check "${LINT_PATH}" --output-format sarif --output ruff.sarif
        uv tool run ruff format "${LINT_PATH}" --check | tee -a ruff-report.txt
      """)
      recordIssues tools: [sarif(pattern: 'ruff.sarif')],
                   publishAllIssues: true,
                   skipPublishingChecks: true,
                   checksAnnotationScope: 'ALL',
                   enabledForFailure: true

      archiveArtifacts artifacts: 'ruff-report.txt, ruff.sarif', allowEmptyArchive: true

      publishChecks name: env.GITHUB_CONTEXT,
                    title: 'Ruff',
                    summary: (rc == 0 ? 'Ruff clean ✅' : 'Ruff found issues ❌'),
                    detailsURL: env.RUN_DISPLAY_URL,
                    text: fileExists('ruff-report.txt') ? readFile('ruff-report.txt') : '',
                    conclusion: (rc == 0 ? 'SUCCESS' : 'FAILURE'),
                    status: 'COMPLETED'

      if (rc != 0) { error 'Ruff lint failed' }
    }
  }
}
    }
  }
}