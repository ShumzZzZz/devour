pipeline {
	agent any
	options {
		buildDiscarder logRotator(
			artifactDaysToKeepStr: '',
			artifactNumToKeepStr: '5',
			daysToKeepStr: '',
			numToKeepStr: '5'
				)
		disableConcurrentBuilds()
		}
		stages {
		stage('Notify') {
			when { anyOf { branch 'main' ; changeRequest() } }
			steps {
				echo 'Push Received!'
			}
		}
		stage('Lint (Ruff)') {
		when { anyOf { branch 'main'; changeRequest() } }
			agent {
				kubernetes {
					defaultContainer 'uv'
					yaml """
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: uv
    image: ghcr.io/astral-sh/uv:0.8.9-python3.12-bookworm
    command: ['sh','-c','cat']
    tty: true
"""
				}
			}
			environment {
				LINT_PATH = '.'
				GITHUB_CONTEXT = 'lint/ruff'	 // this name is what you select in GitHub branch protection
			}
			steps {
				checkout scm

                script {
                    try {
                        withChecks(name: env.GITHUB_CONTEXT, title: 'Ruff', summary: 'Ruff lint running…', detailsURL: env.RUN_DISPLAY_URL) {
                            sh """
set -e
# Produce a readable report; also visible in console
uvx ruff check "${LINT_PATH}" | tee ruff-report.txt

# Optional: also enforce formatting without changing files
uvx ruff format "${LINT_PATH}" --check | tee -a ruff-report.txt
                            """
                        }
                        // Success
                        archiveArtifacts artifacts: 'ruff-report.txt', onlyIfSuccessful: true
                        publishChecks name: env.GITHUB_CONTEXT,
                                      title: 'Ruff',
                                      summary: 'Ruff clean ',
                                      detailsURL: env.RUN_DISPLAY_URL,
                                      text: readFile('ruff-report.txt'),
                                      conclusion: 'SUCCESS',
                                      status: 'COMPLETED'
                    } catch (err) {
                        // Save report even on failure, then mark the GitHub status as failure
                        archiveArtifacts artifacts: 'ruff-report.txt', onlyIfSuccessful: false
                        publishChecks name: env.GITHUB_CONTEXT,
                                      title: 'Ruff',
                                      summary: 'Ruff found issues (see report)',
                                      detailsURL: env.RUN_DISPLAY_URL,
                                      text: fileExists('ruff-report.txt') ? readFile('ruff-report.txt') : '',
                                      conclusion: 'FAILURE',
                                      status: 'COMPLETED'
                        error "Ruff lint failed"
                    }
                }
			}
		}
	}
}
