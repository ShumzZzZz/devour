pipeline {
  agent any

  options {
    buildDiscarder(logRotator(artifactDaysToKeepStr: '', artifactNumToKeepStr: '5', daysToKeepStr: '', numToKeepStr: '5'))
    disableConcurrentBuilds()
  }

  stages {
    // stage('Notify') {
    //   when { anyOf { branch 'main'; changeRequest() } }
    //   steps {
    //     echo 'Push Received!'
    //   }
    // }

    stage('Lint / Ruff') {
      when {
        anyOf {
          branch 'main'
          changeRequest()
        }
      }
      agent { label 'uv' }

      environment {
        LINT_PATH = '.'
        GITHUB_CONTEXT = 'lint/ruff' // used for GitHub Checks
      }

      steps {
        checkout scm

        // Immediately mark the check as in-progress so PRs show activity
        withChecks(name: env.GITHUB_CONTEXT, includeStage: true) {
          publishChecks name: env.GITHUB_CONTEXT,
                       title: 'Ruff',
                       summary: 'Ruff lint started…',
                       status: 'IN_PROGRESS'
        }

        script {
          // Run Ruff, always emit SARIF for rich PR annotations via Warnings NG
          int rc = sh(returnStatus: true, script: '''
#!/usr/bin/env bash
set -euo pipefail
# Human-readable report in console + file
uvx ruff check "${LINT_PATH}" | tee ruff-report.txt
# Emit SARIF for GitHub Checks annotations
uvx ruff check "${LINT_PATH}" --output-format sarif --output ruff.sarif
# Enforce formatting without modifying files; append to report
uvx ruff format "${LINT_PATH}" --check | tee -a ruff-report.txt
''')

          // Publish structured annotations to GitHub through Checks API (via Warnings NG)
          recordIssues tools: [sarif(pattern: 'ruff.sarif')],
                       publishAllIssues: true,
                       skipPublishingChecks: false,
                       checksAnnotationScope: 'ALL',
                       enabledForFailure: true

          // Keep artifacts available for deeper debugging
          archiveArtifacts artifacts: 'ruff-report.txt, ruff.sarif', allowEmptyArchive: true

          // Complete the check with SUCCESS/FAILURE and include the report text
          publishChecks name: env.GITHUB_CONTEXT,
                        title: 'Ruff',
                        summary: (rc == 0 ? 'Ruff clean ✅' : 'Ruff found issues ❌'),
                        detailsURL: env.RUN_DISPLAY_URL,
                        text: fileExists('ruff-report.txt') ? readFile('ruff-report.txt') : '',
                        conclusion: (rc == 0 ? 'SUCCESS' : 'FAILURE'),
                        status: 'COMPLETED'

          if (rc != 0) {
            error 'Ruff lint failed'
          }
        }
      }
    }
  }
}